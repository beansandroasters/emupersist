# Build output
/target/

# Journals (they contain recorded request bodies verbatim: secret values, access key IDs, and so on).
# The default location and places where users tend to save them locally. Excluded broadly so they are not committed
# by mistake.
.emupersist/
*.jsonl
*.db
*.db-wal
*.db-shm

# Files that tend to hold secrets. Also excluded so that a local copy of the emulator CA (ca.pem) or
# credentials (emulator_credentials) is not committed by mistake.
.env
.env.*
*.pem
*.key
*.p12
emulator_credentials
credentials

# A local copy of aws-emulator itself (distributed under a separate license)
/aws-emulator

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Sample journals for the compatibility tests (they contain only test values)
!/tests/fixtures/*.jsonl
